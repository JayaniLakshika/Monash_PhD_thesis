\newlabel{sec-third-paper}{{3}{28}{\texorpdfstring {quollr: An R Package for Visualizing \(2\text {-}D\) Models from Non-linear Dimension Reductions in High Dimensional Space}{quollr: An R Package for Visualizing 2\textbackslash text\{-\}D Models from Non-linear Dimension Reductions in High Dimensional Space}}{chapter.3}{}}
