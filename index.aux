\@writefile{lof}{\contentsline {figure}{\numberline {5.7}{\ignorespaces UMAP misidentifications for selected three-cluster data structures. Each column corresponds to one data structure, and each row shows the resulting $2\text  {-}D${} NLDR layout under different distance scale settings: (a) small (S), (b) small medium (SM), and (c) medium large (ML). UMAP often merges clusters or distorts curved manifolds, particularly when clusters differ in geometric complexity or density.}}{112}{figure.caption.70}\protected@file@percent }
\newlabel{fig-mis-umap}{{5.7}{112}{UMAP misidentifications for selected three-cluster data structures. Each column corresponds to one data structure, and each row shows the resulting \gD {} NLDR layout under different distance scale settings: (a) small (S), (b) small medium (SM), and (c) medium large (ML). UMAP often merges clusters or distorts curved manifolds, particularly when clusters differ in geometric complexity or density}{figure.caption.70}{}}
\citation{ref-laurens2008}
\@writefile{lof}{\contentsline {figure}{\numberline {5.8}{\ignorespaces PaCMAP misidentifications for selected three-cluster data structures. Each column represents a distinct high-dimensional data structure, while each row corresponds to a resulting $2\text  {-}D${} NLDR layout under different distance scale settings: (a) small (S), (b) small medium (SM), (c) medium large (ML), and (d) large (L). PaCMAP effectively maintains intra-cluster cohesion but often distorts the relative geometry between curved and compact clusters, leading to apparent overlaps or misplacement in $2\text  {-}D${} space.}}{113}{figure.caption.72}\protected@file@percent }
\newlabel{fig-mis-pacmap}{{5.8}{113}{PaCMAP misidentifications for selected three-cluster data structures. Each column represents a distinct high-dimensional data structure, while each row corresponds to a resulting \gD {} NLDR layout under different distance scale settings: (a) small (S), (b) small medium (SM), (c) medium large (ML), and (d) large (L). PaCMAP effectively maintains intra-cluster cohesion but often distorts the relative geometry between curved and compact clusters, leading to apparent overlaps or misplacement in \gD {} space}{figure.caption.72}{}}
\citation{ref-moon2019}
\@writefile{toc}{\contentsline {subsubsection}{tSNE}{114}{table.caption.73}\protected@file@percent }
\newlabel{tsne}{{5.4.3}{114}{tSNE}{table.caption.73}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.9}{\ignorespaces tSNE misidentifications for selected three-cluster data structures. Each column represents a distinct high-dimensional data structure, while each row corresponds to a resulting $2\text  {-}D${} NLDR layout under different distance scale settings: (a) small (S), (b) small medium (SM), (c) medium (M), (d) medium large (ML), and (e) large (L). tSNE effectively maintains within-cluster density and separation but tends to distort the global spatial relationships among clusters---especially when the data include non-linear or anisotropic geometries such as hyperbolas, spirals, and pyramids.}}{115}{figure.caption.74}\protected@file@percent }
\newlabel{fig-mis-tsne}{{5.9}{115}{tSNE misidentifications for selected three-cluster data structures. Each column represents a distinct high-dimensional data structure, while each row corresponds to a resulting \gD {} NLDR layout under different distance scale settings: (a) small (S), (b) small medium (SM), (c) medium (M), (d) medium large (ML), and (e) large (L). tSNE effectively maintains within-cluster density and separation but tends to distort the global spatial relationships among clusters---especially when the data include non-linear or anisotropic geometries such as hyperbolas, spirals, and pyramids}{figure.caption.74}{}}
\@writefile{toc}{\contentsline {subsubsection}{PHATE}{116}{table.caption.75}\protected@file@percent }
\newlabel{phate}{{5.4.3}{116}{PHATE}{table.caption.75}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.10}{\ignorespaces PHATE misidentifications for selected three-cluster data structures. Each column represents a distinct high-dimensional data structure, while each row corresponds to a resulting $2\text  {-}D${} NLDR layout under different distance scale settings: (a) small (S), (b) small medium (SM), (c) medium (M), (d) medium large (ML), and (e) large (L). PHATE effectively maintains global continuity but exhibits over-smoothing, leading to partial merging or distortion of geometrically distinct clusters---particularly for combinations involving hyperbolas, pyramids, and cones.}}{117}{figure.caption.76}\protected@file@percent }
\newlabel{fig-mis-phate}{{5.10}{117}{PHATE misidentifications for selected three-cluster data structures. Each column represents a distinct high-dimensional data structure, while each row corresponds to a resulting \gD {} NLDR layout under different distance scale settings: (a) small (S), (b) small medium (SM), (c) medium (M), (d) medium large (ML), and (e) large (L). PHATE effectively maintains global continuity but exhibits over-smoothing, leading to partial merging or distortion of geometrically distinct clusters---particularly for combinations involving hyperbolas, pyramids, and cones}{figure.caption.76}{}}
